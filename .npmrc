# Supply chain (docs/DEPENDENCIES.md).
#
# Install scripts are arbitrary code execution on the developer machine and in CI, and they
# are the most-used npm compromise vector. Nothing this project depends on needs one.
ignore-scripts=true

# New dependencies are written to package.json exactly, not as a caret range.
save-exact=true

# `npm ci` must fail on a Node older than package.json engines, not build something subtly
# different.
engine-strict=true

# Only the public registry, over TLS.
registry=https://registry.npmjs.org/

# Fail loudly rather than reaching for a network fallback when the lockfile disagrees.
audit-level=high
