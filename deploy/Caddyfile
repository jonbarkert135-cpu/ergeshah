# Reverse proxy: TLS termination, and the last place a client IP address exists.
#
# Caddy's access log is disabled on purpose. If you need to debug, enable it temporarily
# and remember that you are creating exactly the artefact this project tries not to have.
{
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

# Replace with your domain. Caddy obtains and renews a certificate automatically, and
# serves a redirect on :80 for it — plain HTTP is answered only long enough to say
# "use HTTPS" (308), which is the HTTP → HTTPS rule the brief asks for.
example.com {
	# TLS 1.2 is the floor and 1.3 is what almost everyone actually negotiates. Written out
	# rather than left to Caddy's default so that a future default cannot silently lower it.
	# The cipher suites are *not* restated: Caddy's list is already AEAD-only with forward
	# secrecy, and a hand-written one is a thing that rots and then either excludes real
	# clients or re-admits something that should have aged out (point 67).
	tls {
		protocols tls1.2 tls1.3
	}

	log {
		output discard
	}

	encode zstd gzip

	# Strip anything that could carry a fingerprint upstream, and refuse the ones a
	# privacy-first service has no business receiving.
	request_header -Referer
	request_header -Cookie-Consent
	header -Server

	reverse_proxy app:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up -X-Forwarded-Port
	}
}

# Liveness for the container health check, on a port that is never published. It answers
# the orchestrator and nothing else: no hostname, no version, no build.
:8081 {
	respond /healthz "ok" 200
	respond 404
}

# The onion service does not pass through Caddy at all: the `tor` container in
# docker-compose.yml maps HiddenServicePort 80 straight to app:8080, so there is no second
# place where a request could be logged or a header rewritten. Nothing to configure here.
