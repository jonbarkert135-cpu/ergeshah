# Copy to .env. Values here are safe defaults for development only.

NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# --- database -----------------------------------------------------------------
# SQLite is the default and is a perfectly good choice for a single small VPS.
DB_DIALECT=sqlite
SQLITE_PATH=data/symvolon.sqlite
# For PostgreSQL, set DB_DIALECT=postgres and provide a URL instead:
# DB_DIALECT=postgres
# DATABASE_URL=postgres://symvolon:CHANGE_ME@db:5432/symvolon

# --- secrets ------------------------------------------------------------------
# Nothing here belongs in Git. This file is the *shape* of the configuration; the values
# live in your deployment. Every secret below can also be supplied as a file by appending
# _FILE to its name — RATE_LIMIT_PEPPER_FILE=/run/secrets/pepper — which is how Docker
# secrets and Kubernetes mount them, and which keeps the value out of `docker inspect`,
# out of the process environment listing and out of a crash dump.
#
# Used to derive daily rotating rate-limit bucket keys, so that no address is ever stored.
# The server refuses to start in production without it.
# Generate with:  openssl rand -base64 48
# Rotating it is safe and cheap: buckets are keyed per day anyway, so the only effect is
# that everyone's current allowance resets. Rotate on any suspicion of database exposure.
RATE_LIMIT_PEPPER=

# --- resource limits ------------------------------------------------------------
# Concurrent sockets this process will hold. Past it the kernel queues connections, which
# is a slow visitor instead of an out-of-memory kill.
MAX_CONNECTIONS=512
# PostgreSQL only: ceiling on a single statement and on an idle transaction.
DB_STATEMENT_TIMEOUT_MS=5000
# Free space that must remain after an upload. Below it, uploads are refused with 503 and
# the rest of the service keeps working — a full disk stops the database, not just uploads.
STORAGE_FLOOR_BYTES=536870912
# How many blob rows (deliveries + attachments) this server will hold. Guards the object
# count, which the free-space floor does not. 0 disables the ceiling.
MAX_BLOB_ROWS=200000

# --- money ---------------------------------------------------------------------
# The marketplace's cut of a completed order, in basis points (500 = 5%), charged to
# the seller. Boot refuses more than 2000.
ORDER_FEE_BPS=500
# Enforced floor on a payout.
MIN_WITHDRAWAL_XMR=0.02
# Enforced (ADR-0067): a smaller transfer is recorded, not credited, and its owner can ask
# for it back once there is enough of it to be worth a transfer (ADR-0071).
MIN_DEPOSIT_XMR=0.02
# The floor on that refund: the platform pays the network fee, so returning dust below this
# is a way to bleed the payout float. About twenty typical Monero fees.
MIN_REFUND_XMR=0.001
# Days without a settled sale before a seller's level falls one step (ADR-0072). The volume
# they earned is not deleted — one sale brings the level back.
SELLER_LEVEL_DECAY_DAYS=90
# Default automatic payout ceiling per account, per request and per 24 hours. Anything
# larger waits for an administrator; per-account limits are set in the admin API.
AUTO_PAYOUT_MAX_XMR=2
# Above this, releasing a payout takes two different administrators (ADR-0076). Refusing
# takes one. With a single admin account, a payout above this cannot be released at all.
DUAL_APPROVAL_ABOVE_XMR=10

# The Monero tier (ADR-0070). Leave MONERO_WALLET_RPC_URL empty and this deployment simply
# does not take top-ups: no address is handed out and the wallet screen says so. The wallet
# at the other end is opened with a private VIEW key — a spend key never belongs on this
# host (docs/PAYMENTS.md §Keys).
MONERO_WALLET_RPC_URL=
# Confirmations before a top-up is credited (~2 minutes each), and how often to look.
DEPOSIT_CONFIRMATIONS=3
# Top-ups at or below this are credited after one confirmation instead (ADR-0077). Zero
# confirmations is never available: an unconfirmed transfer is not money. 0 disables the lane.
FAST_CREDIT_MAX_XMR=0.1
WALLET_POLL_SECONDS=45
# Shared secret the payout worker authenticates with: openssl rand -base64 32
# Empty closes the payout queue endpoints entirely. Prefer PAYOUT_WORKER_TOKEN_FILE.
PAYOUT_WORKER_TOKEN=

# --- rate limits ---------------------------------------------------------------
# Optional JSON overriding any of the per-operation buckets. Unknown scope names and
# nonsensical values stop the server at boot rather than quietly doing nothing.
# Scopes: register, login, account_attempt, recovery, sensitive, message_send, attachment,
#         seller_application, listing_write, order_write, review, moderation, search,
#         key_bundle, read, write
# `account_attempt` counts guesses against one *username* rather than against whoever is
# asking. It is the bucket that still works when the attacker has many addresses, or when
# every request arrives from the same one because the service is reached over Tor.
# Under attack, tighten one scope rather than everything:
# RATE_LIMITS={"register":{"burst":2,"perMinute":0.1},"search":{"burst":10,"perMinute":10}}

# --- deployment ---------------------------------------------------------------
# Whether to believe X-Forwarded-For. Prefer naming the proxy over a bare `true`:
# TRUST_PROXY=127.0.0.1/8, ::1
TRUST_PROXY=true
# Set to false only if you terminate TLS somewhere this app cannot know about, or when
# serving a Tor onion service without TLS.
BEHIND_TLS=true

# --- anti-automation ----------------------------------------------------------
# Leading zero bits an unauthenticated account request (register, login, recovery) must
# find before the server will look at it. No CAPTCHA, no third party, nothing recorded
# about the client: the cost is arithmetic the browser pays once. 16 is a fraction of a
# second and a real bill for someone opening accounts in bulk. Raise it while an attack is
# on; 0 turns the gate off entirely, which is a decision rather than a default.
POW_BITS=16

# --- retention ----------------------------------------------------------------
SESSION_TTL_MS=2592000000
# A session also dies of neglect, not only of old age: this is how many days it may go
# unused. The shorter of the two limits wins.
SESSION_IDLE_DAYS=14
ENVELOPE_TTL_MS=2592000000
MAX_ENVELOPE_BYTES=65536
# Sealed sender (ADR-0084): a client mints single-use tokens while authenticated and spends
# them without a cookie, so the sender is not in the data at rest.
SEND_TOKEN_TTL_MS=604800000
SEND_TOKEN_BATCH=32
# Timing noise (ADR-0085): the cap on the delivery delay a sender may request.
MAX_DELIVERY_DELAY_SECONDS=120
# Seller bond (ADR-0086): staked by a seller, payable to a buyer a moderator finds was harmed.
BOND_MIN_XMR=0.1
BOND_COOLOFF_DAYS=7

# Digital delivery: ciphertext cap per order (bytes before base64url expansion) and how
# long an uncollected delivery is kept. A delivery is held in memory while it is uploaded
# and downloaded, so raising this raises peak memory, not just disk.
MAX_DELIVERY_BYTES=5242880
DELIVERY_TTL_MS=2592000000

# If you also publish an onion service, put its address here. The clearnet site then sends
# an Onion-Location header, and Tor Browser offers the onion version to your users.
# ONION_HOSTNAME=abcdefghijklmnopqrstuvwxyz234567abcdefghijklmnopqrstuvwx.onion

# The name this deployment signs into every authentication challenge (ADR-0087). Any stable
# string identifies a deployment; your host name is the obvious choice. Changing it
# invalidates signatures made for the old value, which is exactly what it is for.
# SERVICE_ID=symvolon

# How long an account's own security history is kept (ADR-0090). Day-granular counts, no
# addresses, visible to the account owner alone.
# SECURITY_EVENT_RETENTION_DAYS=90
