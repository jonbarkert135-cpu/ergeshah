{
  "name": "symvolon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:client",
    "dev": "npm run build:client && node --experimental-strip-types --disable-warning=ExperimentalWarning src/server/main.ts",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server/main.ts",
    "migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server/db/cli.ts",
    "migrate:checksums": "node scripts/audit.mjs migrations --update",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "test:postgres": "vitest run",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "audit:dependencies": "node scripts/audit.mjs dependencies",
    "audit:bundle": "node scripts/audit.mjs bundle",
    "audit:secrets": "node scripts/audit.mjs secrets",
    "audit:history": "node scripts/audit.mjs history",
    "audit:migrations": "node scripts/audit.mjs migrations",
    "audit:supply": "node scripts/audit.mjs supply",
    "audit:cost": "node scripts/audit.mjs cost",
    "audit:egress": "node scripts/audit.mjs egress",
    "audit:inventory": "node scripts/audit.mjs inventory",
    "audit:security": "node scripts/security.mjs scan",
    "audit:baseline": "node scripts/release.mjs baseline",
    "inventory:update": "node scripts/audit.mjs inventory --update",
    "sbom": "node scripts/sbom.mjs",
    "sbom:update": "node scripts/sbom.mjs --update",
    "audit": "npm run audit:deps && npm run audit:dependencies && npm run audit:bundle && npm run audit:secrets && npm run audit:history && npm run audit:migrations && npm run audit:supply && npm run audit:cost && npm run audit:egress && npm run audit:inventory && npm run sbom && npm run audit:security && npm run audit:baseline",
    "audit:deployment": "node scripts/audit.mjs deployment",
    "security": "node scripts/security.mjs pipeline",
    "security:tools": "node scripts/security.mjs tools",
    "release": "node scripts/release.mjs",
    "release:baseline": "node scripts/release.mjs baseline",
    "verify:clean-clone": "node scripts/clean-clone.mjs",
    "backup": "node scripts/backup.mjs create",
    "backup:verify": "node scripts/backup.mjs verify",
    "backup:restore": "node scripts/backup.mjs restore",
    "backup:prune": "node scripts/backup.mjs prune",
    "backup:keygen": "node scripts/backup.mjs keygen",
    "backup:drill": "node scripts/backup.mjs drill",
    "backup:pg": "node scripts/backup-postgres.mjs create",
    "backup:pg:verify": "node scripts/backup-postgres.mjs verify",
    "backup:pg:restore": "node scripts/backup-postgres.mjs restore",
    "backup:pg:prune": "node scripts/backup-postgres.mjs prune",
    "backup:pg:drill": "node scripts/backup-postgres.mjs drill",
    "incident": "node scripts/incident.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "libsodium-wrappers-sumo": "0.7.15",
    "openpgp": "^6.3.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@scure/bip39": "^2.4.0",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "0.28.2",
    "jsqr": "^1.4.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
